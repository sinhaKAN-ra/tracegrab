# Dependencies
node_modules/
webview-ui/node_modules/

# Build output
out/
webview-ui/dist/
*.vsix
*.tsbuildinfo

# Runtime debug artifacts — may contain captured variable values; NEVER commit
.flow-debugger/
docs/screenshots/index.html
docs/screenshots/*.png

# Licensing / entitlement (local, per-user)
.flow-debugger/license.json

# Editor / OS
.DS_Store
.vscode-test/
*.log

# Git worktrees (local experiments; never part of the tracked tree)
.worktrees/

# Agent / tool scratch (local task state, not source)
.agents/
.kiro/settings/

# Env / secrets — defense in depth; nothing credential-bearing should be tracked
.env
.env.*
*.pem
*.key

# Local/private artifacts — not part of the public source
/private/
/examples/


