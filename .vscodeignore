# Exclude everything the runtime extension does not need.
.vscode/**
.kiro/**
.worktrees/**
.agents/**
.githooks/**
.github/**
.git/**
scripts/**
node_modules/**
webview-ui/node_modules/**
webview-ui/src/**
webview-ui/public/**
webview-ui/*.ts
webview-ui/*.json
webview-ui/*.js
webview-ui/*.map
webview-ui/index.html
webview-ui/.gitignore
webview-ui/.oxlintrc.json
webview-ui/README.md
src/**
verify/**
# cli/ ships: the MCP server imports ../cli/collector.mjs and
# ../cli/headless-session.mjs at runtime. Exclude only its tests.
cli/**/*.test.mjs
!mcp/callmap.mjs
!mcp/flow-mcp.mjs
.cursor/**
AGENTS.md
tsconfig.json
**/*.map
**/tsconfig*.json
**/.gitignore
*.vsix
docs/screenshots/**
